#!/usr/bin/env bash
set -eu

INSTALL_DIR=/opt/neovim
# stable tracks the latest release, nightly the daily bleeding-edge build
CHANNEL="${NEOVIM_CHANNEL:-stable}"

sudo apt install -y ninja-build gettext cmake curl build-essential

if [[ -d $INSTALL_DIR ]]; then
    git -C $INSTALL_DIR fetch --tags --force --prune
else
    sudo git clone https://github.com/neovim/neovim.git $INSTALL_DIR
    sudo chown -R $USER:$USER $INSTALL_DIR
fi

# both channels are moving tags, so resolve them to a commit
if ! target=$(git -C $INSTALL_DIR rev-parse --verify --quiet "refs/tags/$CHANNEL^{commit}"); then
    echo "unknown neovim channel '$CHANNEL' (expected stable or nightly)" >&2
    exit 1
fi

# nightly reports its version as v0.13.0-dev-..., which never matches the tag
# name, so compare commits rather than version strings
stamp=$INSTALL_DIR/.installed-commit
installed=""
[[ -r $stamp ]] && installed=$(<"$stamp")

if [[ $installed == "$target" ]] && command -v nvim > /dev/null; then
    echo "neovim $CHANNEL is up to date ($(nvim --version | awk 'NR==1 {print $2; exit}'))"
    exit 0
fi

echo "building neovim $CHANNEL ($(git -C $INSTALL_DIR describe --tags "$target"))"

git -C $INSTALL_DIR checkout --force "$target"

# a build tree from another version cannot be reused
if [[ -d $INSTALL_DIR/build ]]; then
    make -C $INSTALL_DIR distclean
fi

make -C $INSTALL_DIR CMAKE_BUILD_TYPE=RelWithDebInfo
sudo make -C $INSTALL_DIR install

echo "$target" > "$stamp"
nvim --version | awk 'NR==1'
